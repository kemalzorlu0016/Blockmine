rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isValidUserProfile(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 40 &&
             data.titleBadge is string && data.titleBadge.size() >= 1 && data.titleBadge.size() <= 50 &&
             data.skinPreset is string && data.skinPreset.size() >= 1 && data.skinPreset.size() <= 30 &&
             data.hairColorHex is string && data.hairColorHex.size() >= 1 && data.hairColorHex.size() <= 16 &&
             data.tunicColorHex is string && data.tunicColorHex.size() >= 1 && data.tunicColorHex.size() <= 16 &&
             data.pantsColorHex is string && data.pantsColorHex.size() >= 1 && data.pantsColorHex.size() <= 16 &&
             data.capeStyle is string && data.capeStyle.size() >= 1 && data.capeStyle.size() <= 30 &&
             data.level is int && data.level >= 1 && data.level <= 9999 &&
             data.xp is int && data.xp >= 0 &&
             data.coins is int && data.coins >= 0 &&
             data.gems is int && data.gems >= 0 &&
             data.dailyStreak is int && data.dailyStreak >= 0 && data.dailyStreak <= 3650 &&
             data.lastClaimDay is int && data.lastClaimDay >= 0 &&
             data.blocksPlaced is int && data.blocksPlaced >= 0 &&
             data.blocksMined is int && data.blocksMined >= 0 &&
             data.templatesBuilt is int && data.templatesBuilt >= 0 &&
             data.languageCode is string && data.languageCode.size() >= 2 && data.languageCode.size() <= 10 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidFriendEntry(data) {
      return data.userId is string && data.userId == request.auth.uid && data.userId.size() <= 128 &&
             data.friendName is string && data.friendName.size() >= 1 && data.friendName.size() <= 40 &&
             data.friendTag is string && data.friendTag.size() >= 1 && data.friendTag.size() <= 30 &&
             data.status is string && data.status in ['online', 'in_game', 'offline'] &&
             data.serverRoom is string && data.serverRoom.size() <= 60 &&
             data.skinPreset is string && data.skinPreset.size() >= 1 && data.skinPreset.size() <= 30 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    function isValidServerRoom(data) {
      return data.ownerId is string && data.ownerId.size() >= 1 && data.ownerId.size() <= 128 &&
             data.roomName is string && data.roomName.size() >= 1 && data.roomName.size() <= 50 &&
             data.gameMode is string && data.gameMode in ['creative', 'survival', 'exploration'] &&
             data.region is string && data.region.size() >= 1 && data.region.size() <= 20 &&
             data.playerCount is int && data.playerCount >= 1 && data.playerCount <= 64 &&
             data.maxPlayers is int && data.maxPlayers >= 1 && data.maxPlayers <= 64 &&
             data.memberUids is list && data.memberUids.size() >= 1 && data.memberUids.size() <= 10 &&
             (data.memberUids.size() == 0 || data.memberUids[0] is string) &&
             request.auth.uid in data.memberUids &&
             data.lastChatMessage is string && data.lastChatMessage.size() <= 200 &&
             data.createdAt is timestamp && data.createdAt <= request.time &&
             data.updatedAt is timestamp && data.updatedAt <= request.time;
    }

    match /users/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;
      allow list: if isSignedIn() && request.auth.uid == userId;

      allow create: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       incoming().keys().hasAll([
                         'userId', 'username', 'titleBadge', 'skinPreset',
                         'hairColorHex', 'tunicColorHex', 'pantsColorHex', 'capeStyle',
                         'level', 'xp', 'coins', 'gems', 'dailyStreak', 'lastClaimDay',
                         'blocksPlaced', 'blocksMined', 'templatesBuilt', 'languageCode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId', 'username', 'titleBadge', 'skinPreset',
                         'hairColorHex', 'tunicColorHex', 'pantsColorHex', 'capeStyle',
                         'level', 'xp', 'coins', 'gems', 'dailyStreak', 'lastClaimDay',
                         'blocksPlaced', 'blocksMined', 'templatesBuilt', 'languageCode',
                         'createdAt', 'updatedAt'
                       ]) &&
                       isValidUserProfile(incoming());

      allow update: if isSignedIn() &&
                       isValidId(userId) &&
                       request.auth.uid == userId &&
                       isValidUserProfile(incoming()) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'username', 'titleBadge', 'skinPreset',
                         'hairColorHex', 'tunicColorHex', 'pantsColorHex', 'capeStyle',
                         'level', 'xp', 'coins', 'gems', 'dailyStreak', 'lastClaimDay',
                         'blocksPlaced', 'blocksMined', 'templatesBuilt', 'languageCode',
                         'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(userId) && request.auth.uid == userId;

      match /friends/{friendId} {
        allow get: if isSignedIn() && isValidId(userId) && isValidId(friendId) && request.auth.uid == userId;
        allow list: if isSignedIn() && request.auth.uid == userId;

        allow create: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(friendId) &&
                         request.auth.uid == userId &&
                         incoming().keys().hasAll([
                           'userId', 'friendName', 'friendTag', 'status',
                           'serverRoom', 'skinPreset', 'createdAt', 'updatedAt'
                         ]) &&
                         incoming().keys().hasOnly([
                           'userId', 'friendName', 'friendTag', 'status',
                           'serverRoom', 'skinPreset', 'createdAt', 'updatedAt'
                         ]) &&
                         isValidFriendEntry(incoming());

        allow update: if isSignedIn() &&
                         isValidId(userId) &&
                         isValidId(friendId) &&
                         request.auth.uid == userId &&
                         isValidFriendEntry(incoming()) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'friendName', 'friendTag', 'status', 'serverRoom', 'skinPreset', 'updatedAt'
                         ]);

        allow delete: if isSignedIn() && isValidId(userId) && isValidId(friendId) && request.auth.uid == userId;
      }
    }

    match /servers/{serverId} {
      allow get: if isSignedIn() && isValidId(serverId) && request.auth.uid in existing().memberUids;
      allow list: if isSignedIn() && request.auth.uid in existing().memberUids;

      allow create: if isSignedIn() &&
                       isValidId(serverId) &&
                       incoming().ownerId == request.auth.uid &&
                       incoming().keys().hasAll([
                         'ownerId', 'roomName', 'gameMode', 'region',
                         'playerCount', 'maxPlayers', 'memberUids',
                         'lastChatMessage', 'createdAt', 'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'ownerId', 'roomName', 'gameMode', 'region',
                         'playerCount', 'maxPlayers', 'memberUids',
                         'lastChatMessage', 'createdAt', 'updatedAt'
                       ]) &&
                       isValidServerRoom(incoming());

      allow update: if isSignedIn() &&
                       isValidId(serverId) &&
                       isValidServerRoom(incoming()) &&
                       request.auth.uid in existing().memberUids &&
                       incoming().ownerId == existing().ownerId &&
                       incoming().createdAt == existing().createdAt &&
                       incoming().diff(existing()).affectedKeys().hasOnly([
                         'roomName', 'gameMode', 'playerCount', 'memberUids', 'lastChatMessage', 'updatedAt'
                       ]);

      allow delete: if isSignedIn() && isValidId(serverId) && existing().ownerId == request.auth.uid;
    }
  }
}
